# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode from the /api Vercel Functions
__pycache__/
*.pyc
slices/
audit/
logs/faq-misses.json

# FAQ authoring scratch: audit rows + per-agent slices, ~1.3 MB a round. The
# BANK is committed (content/tutor-faq/math5/*.ts); this is the input to the
# merge that produces it, and it is regenerated by scripts/audit-tutor-faq.ts.
.faq-*/
